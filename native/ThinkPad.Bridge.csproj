<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><Authors>Matt Cabrices</Authors><Company>Matt Cabrices</Company><Copyright>Copyright (c) 2026 Matt Cabrices and ThinkPad Control contributors</Copyright>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
  </ItemGroup>
  <ItemGroup>
    <AssemblyMetadata Include="TpfcEngineSha256" Value="$(TpfcEngineSha256)" Condition="'$(TpfcEngineSha256)' != ''" />
  </ItemGroup>
</Project>